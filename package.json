    "@kontent-ai/eslint-config": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.1.4",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
