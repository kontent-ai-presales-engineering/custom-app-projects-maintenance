# Server-side variables, read by the Vercel Functions in api/. Never commit real values.
# In production, set them in Vercel: Project > Settings > Environment Variables,
# then redeploy (Vercel applies variable changes to new deployments only).

# --- Kontent.ai subscription (read-only use) ---
KONTENT_SUBSCRIPTION_ID=
KONTENT_SUBSCRIPTION_API_KEY=

# --- Master ---
KONTENT_MASTER_ENVIRONMENT_ID=

# --- Management API keys: one variable per environment, no code change needed ---
# Name: KONTENT_MAPI_KEY_<environment ID with "-" replaced by "_">
# Optional fallback per project: KONTENT_MAPI_KEY_<project ID with "-" replaced by "_">
# The app shows the exact variable name for every environment that has no key yet.
# KONTENT_MAPI_KEY_00000000_0000_0000_0000_000000000000=

# --- Access ---
# Random string, at least 32 characters. Put the same value in the custom app
# Parameters {JSON} as {"accessSecret": "<value>"}. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
APP_ACCESS_SECRET=
# Comma-separated role codenames or role IDs in the master environment. Default: project-manager
ALLOWED_ROLES=project-manager

# Reserved codename prefix for client-only extensions. Default: client_
CLIENT_PREFIX=client_

# --- Storage ---
# Set automatically when a Vercel Blob store is connected to the project.
# BLOB_READ_WRITE_TOKEN=
