{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@kontent-ai/biome-config/base", "@kontent-ai/biome-config/react"],
  "linter": {
    "rules": {
      "complexity": {
        "noVoid": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["server/**", "api/**"],
      "linter": {
        "rules": {
          "correctness": {
            "useImportExtensions": { "level": "error", "options": { "forceJsExtensions": true } }
          }
        }
      }
    }
  ]
}
